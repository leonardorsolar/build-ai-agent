# Modelo do arquivo .env (este arquivo PODE ir para o Git).
# Como usar:
#   1. Copie este arquivo com o nome .env
#   2. Troque o valor abaixo pela sua chave real da OpenAI
#   3. Nunca envie o .env para o Git
OPENAI_API_KEY=sua-chave-aqui

# NOVO: chave do Tavily, usada pela ferramenta de busca na web (web_search).
# Crie uma conta gratuita em https://tavily.com e copie a chave (começa com "tvly-").
TAVILY_API_KEY=sua-chave-tavily-aqui
